{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/games",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/saturday/six",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/drops",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/shop/:slug*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/collection/:slug*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/checkout",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/order/:id*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(products|heroes|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
