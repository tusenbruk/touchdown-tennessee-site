# Drop List signup (Buttondown). Copy to .env or set in the Vercel project.
# Leave all of these unset to keep the signup form hidden / in dry run.

# Show the signup form in the footer. Without this the footer says the list opens soon.
VITE_NEWSLETTER_ENABLED=false

# Server-side only. Never prefix with VITE_.
BUTTONDOWN_API_KEY=

# Safety switch: real subscribers are only created when a key is set AND this is exactly 0.
NEWSLETTER_DRY_RUN=1

# Optional overrides
# BUTTONDOWN_API_URL=https://api.buttondown.com/v1/subscribers
# NEWSLETTER_TAG=touchdown-tennessee-site
